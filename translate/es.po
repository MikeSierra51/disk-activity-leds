msgid "Disk activity LEDs"
msgstr "LEDs de actividad de discos"

msgid "Reading"
msgstr "Lectura"

msgid "Writing"
msgstr "Escritura"

msgid "Reading and writing"
msgstr "Lectura y escritura"

msgid "Idle"
msgstr "Inactivo"

msgid "%1 GB/s"
msgstr "%1 GB/s"

msgid "%1 MB/s"
msgstr "%1 MB/s"

msgid "%1 kB/s"
msgstr "%1 kB/s"

msgid "%1 B/s"
msgstr "%1 B/s"

msgid "Not mounted"
msgstr "Sin montar"

msgid "Partition: %1 • %2"
msgstr "Partición: %1 • %2"

msgid "Mount point: %1"
msgstr "Punto de montaje: %1"

msgid "State: %1"
msgstr "Estado: %1"

msgid "Read: %1 • Write: %2"
msgstr "Lectura: %1 • Escritura: %2"

msgid "Serial number: %1"
msgstr "Número de serie: %1"

msgid "No physical disk detected"
msgstr "No se ha detectado ningún disco físico"

msgid "%1 monitored partition"
msgid_plural "%1 monitored partitions"
msgstr[0] "%1 partición supervisada"
msgstr[1] "%1 particiones supervisadas"

msgid "Invalid monitoring response"
msgstr "Respuesta de supervisión no válida"

msgid "Disk monitoring encountered an error"
msgstr "Se ha producido un error al supervisar los discos"

msgid "Unable to read disk status"
msgstr "No se puede leer el estado de los discos"

msgid "Unable to read the partition list."
msgstr "No se puede leer la lista de particiones."

msgid "Partition detection failed."
msgstr "Ha fallado la detección de particiones."

msgid "Invalid partition detection response."
msgstr "La respuesta de detección de particiones no es válida."

msgid "Select the partitions to display. The optional custom label is limited to five characters."
msgstr "Seleccione las particiones que desea mostrar. La etiqueta personalizada es opcional y está limitada a cinco caracteres."

msgid "USB volume choices are remembered by UUID and reapplied the next time they are connected."
msgstr "Las opciones de los volúmenes USB se recuerdan por UUID y se vuelven a aplicar la próxima vez que se conectan."

msgid "Displayed partitions"
msgstr "Particiones mostradas"
