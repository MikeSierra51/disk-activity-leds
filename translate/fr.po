msgid "Disk activity LEDs"
msgstr "Voyants d'activité des disques"

msgid "Reading"
msgstr "Lecture"

msgid "Writing"
msgstr "Écriture"

msgid "Reading and writing"
msgstr "Lecture et écriture"

msgid "Idle"
msgstr "Inactif"

msgid "%1 GB/s"
msgstr "%1 Go/s"

msgid "%1 MB/s"
msgstr "%1 Mo/s"

msgid "%1 kB/s"
msgstr "%1 ko/s"

msgid "%1 B/s"
msgstr "%1 o/s"

msgid "Not mounted"
msgstr "Non monté"

msgid "Partition: %1 • %2"
msgstr "Partition : %1 • %2"

msgid "Mount point: %1"
msgstr "Point de montage : %1"

msgid "State: %1"
msgstr "État : %1"

msgid "Read: %1 • Write: %2"
msgstr "Lecture : %1 • Écriture : %2"

msgid "Serial number: %1"
msgstr "N° de série : %1"

msgid "No physical disk detected"
msgstr "Aucun disque physique détecté"

msgid "%1 monitored partition"
msgid_plural "%1 monitored partitions"
msgstr[0] "%1 partition surveillée"
msgstr[1] "%1 partitions surveillées"

msgid "Invalid monitoring response"
msgstr "Réponse de surveillance incorrecte"

msgid "Disk monitoring encountered an error"
msgstr "La surveillance des disques a rencontré une erreur"

msgid "Unable to read disk status"
msgstr "Impossible de lire l'état des disques"

msgid "Unable to read the partition list."
msgstr "Impossible de lire la liste des partitions."

msgid "Partition detection failed."
msgstr "La détection des partitions a échoué."

msgid "Invalid partition detection response."
msgstr "La réponse de détection est incorrecte."

msgid "Select the partitions to display. The optional custom label is limited to five characters."
msgstr "Cochez les partitions à afficher. Le nom personnalisé est facultatif et limité à cinq caractères."

msgid "USB volume choices are remembered by UUID and reapplied the next time they are connected."
msgstr "Les choix des volumes USB sont mémorisés par UUID et seront réappliqués à leur prochain branchement."

msgid "Displayed partitions"
msgstr "Partitions affichées"
